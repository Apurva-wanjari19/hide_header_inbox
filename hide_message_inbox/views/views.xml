<odoo>
    <record id="res_config_settings_view_form_inherit_msg_icon" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.msg.icon</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form[@js_class='base_settings']" position="inside">

                <div class="app_settings_block" string="Messaging">
                    <h2>Messaging</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left">
                                    <span class="o_form_label">
                                        Hide Inbox Icon
                                    </span>
                                    <div class="text-muted">
                                        Hide the messaging inbox icon in the navbar.
                                    </div>
                                </div>
                                <div class="o_setting_right">
                                    <field name="enable_message_icon"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left">
                                    <span class="o_form_label">
                                        Hide Activity Counter Icon
                                    </span>
                                    <div class="text-muted">
                                       Hide Activity Counter bell icon in the navbar.
                                    </div>
                                </div>
                                <div class="o_setting_right">
                                    <field name="hide_notification_icon"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>



